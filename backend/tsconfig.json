{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // As classes DTO são preenchidas pelo ValidationPipe/class-transformer, não
    // pelo construtor, então exigir inicialização em toda propriedade obrigaria
    // a poluir ~20 arquivos de DTO com `!`. Mantemos o restante do `strict`
    // (noImplicitAny, strictNullChecks, strictFunctionTypes, etc.) ligado.
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
