generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Estabelecimento (tenant): cada casa/empresa tem seu próprio cardápio, pedidos,
// produtos e configurações. O slug é usado na URL pública /cardapio/:slug.
model Estabelecimento {
  id            String         @id @default(uuid())
  nome          String
  slug          String         @unique
  telefone      String? // contato do estabelecimento (exibido no pedido/WhatsApp)
  plano         String         @default("DELIVERY") // DELIVERY | MESA | COMPLETO
  usuarios      Usuario[]
  categorias    Categoria[]
  produtos      Produto[]
  ingredientes  Ingrediente[]
  pedidos       Pedido[]
  mesas         Mesa[]
  comandas      Comanda[]
  configuracoes Configuracao[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
}

model Categoria {
  id                String          @id @default(uuid())
  nome              String
  visivel           Boolean         @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  produtos          Produto[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Toda listagem do painel filtra por estabelecimento: sem este índice a
  // tabela inteira é varrida a cada requisição.
  @@index([estabelecimentoId])
}

model Produto {
  id                String          @id @default(uuid())
  nome              String
  descricao         String?
  // Decimal (não Float): dinheiro não pode passar por ponto flutuante,
  // senão somas como 0.1 + 0.2 guardam 0.30000000000000004.
  preco             Decimal
  imagemUrl         String?
  // PADRAO: todo ingrediente ja vem incluso e o cliente remove/adiciona.
  // MARMITA: nada vem incluso, o cliente monta o pedido e cada grupo tem um
  // teto de escolhas.
  tipo              String          @default("PADRAO")
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  categoria         Categoria       @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  categoriaId       String
  itensPedido       ItemPedido[]
  ingredientes      ProdutoIngrediente[]
  grupos            ProdutoGrupo[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Cardápio público: WHERE estabelecimentoId (+ categoriaId opcional)
  @@index([estabelecimentoId])
  @@index([categoriaId])
  @@index([estabelecimentoId, categoriaId])
}

// Seção de escolha dentro de um produto ("Proteínas", "Acompanhamentos").
// maximoEscolhas limita quantas porções o cliente pode somar no grupo, contando
// repetição: maximoEscolhas = 2 permite duas vezes a mesma proteína.
// minimoEscolhas é o piso: com 1 o cliente é obrigado a escolher no grupo
// antes de mandar o pedido. Nunca passa do maximoEscolhas.
model ProdutoGrupo {
  id             String  @id @default(uuid())
  produtoId      String
  nome           String
  ordem          Int     @default(0)
  maximoEscolhas Int     @default(99)
  minimoEscolhas Int     @default(0)
  produto        Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ingredientes   ProdutoIngrediente[]

  @@unique([produtoId, nome])
}

model Ingrediente {
  id                String          @id @default(uuid())
  nome              String
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  produtos          ProdutoIngrediente[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([estabelecimentoId])
  @@index([estabelecimentoId, nome])
}

model ProdutoIngrediente {
  id              String         @id @default(uuid())
  produtoId       String
  ingredienteId   String
  precoAdicional  Decimal       @default(0)
  // Grupo de escolha a que este ingrediente pertence. Nulo = ingrediente
  // solto, sem teto de escolhas.
  grupoId         String?
  produto         Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ingrediente     Ingrediente    @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)
  grupo           ProdutoGrupo?  @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  @@unique([produtoId, ingredienteId])
  @@index([grupoId])
}

model Pedido {
  id                String          @id @default(uuid())
  cliente           String
  tipoEntrega       String          @default("RETIRADA") // RETIRADA, ENTREGA ou MESA
  endereco          String?
  telefone          String?
  taxaEntrega       Decimal         @default(0)
  status            String          @default("PENDENTE") // PENDENTE, EM_PREPARO, EM_ROTA, PRONTO, CONCLUIDO, CANCELADO — validado por UpdatePedidoDto
  total             Decimal
  formaPagamento    String          @default("DINHEIRO") // DINHEIRO, PIX, CARTAO
  trocoPara         Decimal? // valor recebido em dinheiro: troco a ser devolvido = trocoPara - total
  origem            String          @default("DELIVERY") // MESA | BALCAO | DELIVERY | RETIRADA
  numeroMesa        Int?
  mesaId            String?
  mesa              Mesa?           @relation(fields: [mesaId], references: [id])
  comandaId         String?
  comanda           Comanda?        @relation(fields: [comandaId], references: [id])
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  itens             ItemPedido[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Painel: lista os pedidos do tenant em ordem; acompanha o filtro por status
  @@index([estabelecimentoId])
  @@index([estabelecimentoId, status])
  @@index([estabelecimentoId, createdAt])
  @@index([comandaId])
  @@index([mesaId])
}

model ItemPedido {
  id         String   @id @default(uuid())
  quantidade Int
  preco      Decimal
  removidos  String   @default("[]") // nomes dos ingredientes removidos (JSON)
  adicionados String  @default("[]") // nomes dos ingredientes adicionados (JSON)
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId   String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  produtoId  String

  // Os itens entram sempre pelos dois lados: pelo pedido (listagem) e pelo
  // produto (cardápio com itens usados)
  @@index([pedidoId])
  @@index([produtoId])
}

model Usuario {
  id               String           @id @default(uuid())
  nome             String
  email            String           @unique // usado no login; sempre armazenado em minúsculas
  senhaHash        String
  // Versão dos tokens do usuário. Vai no payload do JWT e é conferida pelo
  // AuthGuard a cada requisição: incrementá-la (logout global / troca de
  // senha) invalida imediatamente todos os access tokens já emitidos.
  tokenVersao      Int              @default(0)
  estabelecimentoId String
  estabelecimento  Estabelecimento  @relation(fields: [estabelecimentoId], references: [id])
  recuperacoesSenha RecuperacaoSenha[]
  refreshTokens    RefreshToken[]
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt

  // Listagem de usuários do estabelecimento no painel
  @@index([estabelecimentoId])
}

// Refresh tokens (rotação a cada uso). Como os códigos de recuperação, o
// token em si nunca é armazenado: só o hash HMAC-SHA256. Reutilizar um token
// já rotacionado é tratado como possível roubo e derruba todas as sessões.
model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime? // preenchido na rotação/logout; nulo enquanto válido
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
}

// Tokens de recuperação de senha (single-use, com expiração). O token em si
// nunca é armazenado: só o seu hash HMAC-SHA256 (mesma técnica do IP).
model RecuperacaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String
  expiraEm  DateTime
  usadoEm   DateTime? // preenchido quando consumido/invalidado
  criadoEm  DateTime  @default(now())

  @@index([usuarioId])
  @@index([tokenHash])
}

// Configurações de cada estabelecimento (chave -> valor), escopadas por tenant
model Configuracao {
  estabelecimentoId String
  chave             String
  valor             String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@id([estabelecimentoId, chave])
}

model Mesa {
  id                String          @id @default(uuid())
  numero            Int
  status            String          @default("LIVRE") // LIVRE | OCUPADA
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  comandas          Comanda[]
  pedidos           Pedido[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([estabelecimentoId, numero])
  @@index([estabelecimentoId])
  @@index([estabelecimentoId, status])
}

model Comanda {
  id                String          @id @default(uuid())
  codigo            String          @unique
  mesaId            String
  mesa              Mesa            @relation(fields: [mesaId], references: [id])
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  status            String          @default("ABERTA") // ABERTA | FECHADA | CANCELADA
  pedidos           Pedido[]
  fechadoPorId      String?
  fechadoEm         DateTime?
  observacao        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([estabelecimentoId, status])
  @@index([mesaId, status])
}

model TentativaLogin {
  id        String   @id @default(uuid())
  ipHash    String // hash (HMAC) do IP, sem armazenar o IP em texto puro
  emailHash String? // hash (HMAC) do e-mail tentado; nulo em tentativas sem e-mail válido
  sucesso   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([ipHash, criadoEm])
  @@index([emailHash, criadoEm])
}
