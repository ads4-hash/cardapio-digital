generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Estabelecimento (tenant): cada casa/empresa tem seu próprio cardápio, pedidos,
// produtos e configurações. O slug é usado na URL pública /cardapio/:slug.
model Estabelecimento {
  id            String         @id @default(uuid())
  nome          String
  slug          String         @unique
  telefone      String? // contato do estabelecimento (exibido no pedido/WhatsApp)
  usuarios      Usuario[]
  categorias    Categoria[]
  produtos      Produto[]
  ingredientes  Ingrediente[]
  pedidos       Pedido[]
  configuracoes Configuracao[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Categoria {
  id                String          @id @default(uuid())
  nome              String
  visivel           Boolean         @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  produtos          Produto[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Produto {
  id                String          @id @default(uuid())
  nome              String
  descricao         String?
  preco             Float
  imagemUrl         String?
  // PADRAO: todo ingrediente ja vem incluso e o cliente remove/adiciona.
  // MARMITA: nada vem incluso, o cliente monta o pedido e cada grupo tem um
  // teto de escolhas.
  tipo              String          @default("PADRAO")
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  categoria         Categoria       @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  categoriaId       String
  itensPedido       ItemPedido[]
  ingredientes      ProdutoIngrediente[]
  grupos            ProdutoGrupo[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Seção de escolha dentro de um produto ("Proteínas", "Acompanhamentos").
// maximoEscolhas limita quantas porções o cliente pode somar no grupo, contando
// repetição: maximoEscolhas = 2 permite duas vezes a mesma proteína.
model ProdutoGrupo {
  id             String  @id @default(uuid())
  produtoId      String
  nome           String
  ordem          Int     @default(0)
  maximoEscolhas Int     @default(99)
  produto        Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ingredientes   ProdutoIngrediente[]

  @@unique([produtoId, nome])
}

model Ingrediente {
  id                String          @id @default(uuid())
  nome              String
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  produtos          ProdutoIngrediente[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProdutoIngrediente {
  id              String         @id @default(uuid())
  produtoId       String
  ingredienteId   String
  precoAdicional  Float          @default(0)
  // Grupo de escolha a que este ingrediente pertence. Nulo = ingrediente
  // solto, sem teto de escolhas.
  grupoId         String?
  produto         Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ingrediente     Ingrediente    @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)
  grupo           ProdutoGrupo?  @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  @@unique([produtoId, ingredienteId])
  @@index([grupoId])
}

model Pedido {
  id                String          @id @default(uuid())
  cliente           String
  tipoEntrega       String          @default("RETIRADA") // RETIRADA ou ENTREGA
  endereco          String?
  telefone          String?
  taxaEntrega       Float           @default(0)
  status            String          @default("PENDENTE") // PENDENTE, EM_PREPARO, EM_ROTA, PRONTO, CONCLUIDO, CANCELADO — validado por UpdatePedidoDto
  total             Float
  formaPagamento    String          @default("DINHEIRO") // DINHEIRO, PIX, CARTAO
  trocoPara         Float? // valor recebido em dinheiro: troco a ser devolvido = trocoPara - total
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  itens             ItemPedido[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ItemPedido {
  id         String   @id @default(uuid())
  quantidade Int
  preco      Float
  removidos  String   @default("[]") // nomes dos ingredientes removidos (JSON)
  adicionados String  @default("[]") // nomes dos ingredientes adicionados (JSON)
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId   String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  produtoId  String
}

model Usuario {
  id               String           @id @default(uuid())
  nome             String
  email            String           @unique // usado no login; sempre armazenado em minúsculas
  senhaHash        String
  estabelecimentoId String
  estabelecimento  Estabelecimento  @relation(fields: [estabelecimentoId], references: [id])
  recuperacoesSenha RecuperacaoSenha[]
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt
}

// Tokens de recuperação de senha (single-use, com expiração). O token em si
// nunca é armazenado: só o seu hash HMAC-SHA256 (mesma técnica do IP).
model RecuperacaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String
  expiraEm  DateTime
  usadoEm   DateTime? // preenchido quando consumido/invalidado
  criadoEm  DateTime  @default(now())

  @@index([usuarioId])
  @@index([tokenHash])
}

// Configurações de cada estabelecimento (chave -> valor), escopadas por tenant
model Configuracao {
  estabelecimentoId String
  chave             String
  valor             String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@id([estabelecimentoId, chave])
}

model TentativaLogin {
  id        String   @id @default(uuid())
  ipHash    String // hash (HMAC) do IP, sem armazenar o IP em texto puro
  emailHash String? // hash (HMAC) do e-mail tentado; nulo em tentativas sem e-mail válido
  sucesso   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([ipHash, criadoEm])
  @@index([emailHash, criadoEm])
}
