# Copie este arquivo para `.env` e preencha os valores reais
# (nunca versionar o .env; o exemplo abaixo é apenas referência)

# Banco de dados (SQLite). Para Docker, use um caminho com volume persistente.
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT e hashear os IPs das tentativas de login.
# Use um valor longo e aleatório, por exemplo: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Porta da API (padrão: 3000)
PORT=3000

# Origens permitidas no CORS, separadas por vírgula (sem espaços).
# Exemplo: http://localhost:4200,https://cardapio.minhaempresa.com
CORS_ORIGIN="http://localhost:4200"

# Apenas defina como "true" se a aplicação roda atrás de um proxy (Nginx, Render, etc.)
# que preenche o header X-Forwarded-For com o IP real do cliente.
CONFIAR_PROXY="false"

# E-mail (SMTP) para envio da recuperação de senha.
# Deixe SMTP_HOST vazio para o modo local: o código é devolvido pela API e
# exibido na tela de recuperação (somente fora de produção).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="App Cardápio <noreply@exemplo.com>"

# URL pública do frontend (usada no link de recuperação enviado por e-mail)
FRONTEND_URL="http://localhost:4200"